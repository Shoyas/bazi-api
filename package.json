{
  "name": "bazi-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:api": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "concurrently \"npm run start:api\" \"npm run worker\"",
    "start:api": "cross-env NODE_ENV=production node dist/server.js",
    "test": "vitest",
    "prisma": "npx prisma migrate dev --name init && npx prisma generate && npx prisma db push",
    "noEmit": "tsc --noEmit",
    "docker-build": "docker compose up -d --build",
    "docker-down": "docker compose down",
    "worker": "cross-env NODE_ENV=production node dist/worker.js",
    "dev:worker": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/worker.ts"
  },
  "keywords": [],
  "author": "Md. Nasir Uddin Shoyas",
  "license": "MIT",
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.41.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "http-status": "^2.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lunar-typescript": "^1.8.6",
    "moment-timezone": "^0.6.3",
    "nodemailer": "^9.0.5",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/moment-timezone": "^0.5.13",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.1"
  }
}
